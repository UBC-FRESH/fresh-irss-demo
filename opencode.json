          "resource": "find * -delete*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "find * -exec*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "find * -ok*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
